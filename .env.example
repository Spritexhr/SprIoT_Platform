# ===========================================
# 启动必备环境变量（仅进程级配置，复制为 .env 后修改）
# 业务配置（MQTT broker、离线超时、数据保留等）已迁移到 PlatformConfig 表，
# 通过 `python manage.py configure` 维护，不再写在这里。
# ===========================================

# ---- Django 必备 ----
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# ---- 反向代理 / 公网域名（逗号分隔，必须带协议）----
# Django Admin 经 HTTPS 域名提交表单时必须加入 CSRF 可信来源。
EXTRA_CSRF_TRUSTED_ORIGINS=https://iot-admin.example.com

# ---- MySQL 必备（Docker 部署）----
DB_NAME=iot_platform
DB_USER=root
DB_PASSWORD=your_mysql_password

# ---- 端口（Docker 宿主机暴露）----
MYSQL_HOST_PORT=3307
# 前端访问端口：选用五位高端口避开 8080 等常见冲突
FRONTEND_PORT=48080
# Django Admin 直连端口（仅管理员/排错用）
ADMIN_PORT=48081

# ---- MCP（可选，通过 `docker compose --profile mcp` 启动）----
# 当前写接口要求 is_staff；请创建独立的非超级管理员 staff 账号，不要复用个人账号。
MCP_HOST_PORT=48082
IOT_API_USERNAME=your_agent_account
IOT_API_PASSWORD=your_agent_password
# 也可以使用 IOT_API_ACCESS_TOKEN，但短期 JWT 过期后无法自动重新签发。
IOT_MCP_CONFIRMATION_SECRET=replace_with_a_long_random_secret

# ---- 非 Docker 部署且使用 MySQL 时取消注释 ----
# DB_USE_MYSQL=true
# DB_HOST=localhost
# DB_PORT=3306
