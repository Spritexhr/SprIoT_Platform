# ===========================================
# 启动必备环境变量（仅进程级配置，复制为 .env 后修改）
# 业务配置（MQTT broker、离线超时、数据保留等）已迁移到 PlatformConfig 表，
# 通过 `python manage.py configure` 维护，不再写在这里。
# ===========================================

# ---- Django 必备 ----
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# ---- 反向代理 / 公网域名（逗号分隔，必须带协议）----
# Django Admin 经 HTTPS 域名提交表单时必须加入 CSRF 可信来源。
EXTRA_CSRF_TRUSTED_ORIGINS=https://iot-admin.example.com

# ---- 高风险能力（默认关闭）----
# 自定义 Python 自动化在独立限时子进程中执行，但不是 OS 沙箱，仍具有容器权限。
AUTOMATION_SCRIPT_EXECUTION_ENABLED=False
# 单次脚本硬超时（秒），默认 10 秒覆盖设备确认完整等待；必须 > 0 且不超过 60。
AUTOMATION_SCRIPT_TIMEOUT_SECONDS=10
# 同一规则跨 Web worker / 调度器的 Redis 单飞锁前缀。
AUTOMATION_SCRIPT_LOCK_PREFIX=spr:iot:automation:execution
# auto 优先使用预加载 Django 的 forkserver；兼容异常时设为 spawn 可立即回滚。
AUTOMATION_EXECUTOR_START_METHOD=auto

# MQTT 入站消息与死信单条大小上限，防止毒消息耗尽 runner/Redis 内存。
MQTT_INBOUND_MAX_PAYLOAD_BYTES=262144
MQTT_DEAD_LETTER_MAX_PAYLOAD_BYTES=65536

# ---- 历史数据清理（默认不启动）----
# data_cleanup 位于 maintenance profile，需显式执行：
# docker compose --profile maintenance up -d data_cleanup
# 容器每次启动都会先 dry-run，再等待至少 1 小时后首次真实清理。
DATA_CLEANUP_INITIAL_DELAY_SECONDS=86400
DATA_CLEANUP_INTERVAL_SECONDS=86400
DATA_CLEANUP_BATCH_SIZE=1000

# ---- MySQL 必备（Docker 部署）----
# Docker 服务已显式使用 production；宿主机本地调试建议使用 local。
IOT_RUNTIME_ENV=production
DB_NAME=iot_platform
DB_USER=root
DB_PASSWORD=your_mysql_password
# MySQL 连接复用秒数；设为 0 可关闭持久连接
DB_CONN_MAX_AGE=60

# ---- 端口（Docker 宿主机暴露）----
MYSQL_HOST_PORT=3307
# 前端访问端口：选用五位高端口避开 8080 等常见冲突
FRONTEND_PORT=48080
# Django Admin 直连端口（仅管理员/排错用）
ADMIN_PORT=48081

# ---- MCP（默认随 Docker Compose 一起构建和启动）----
# 当前写接口要求 is_staff；请创建独立的非超级管理员 staff 账号，不要复用个人账号。
MCP_HOST_PORT=48082
IOT_API_USERNAME=your_agent_account
IOT_API_PASSWORD=your_agent_password
# 也可以使用 IOT_API_ACCESS_TOKEN，但短期 JWT 过期后无法自动重新签发。
IOT_MCP_CONFIRMATION_SECRET=replace_with_a_long_random_secret

# ---- 非 Docker 部署且使用 MySQL 时取消注释 ----
# DB_USE_MYSQL=true
# DB_HOST=localhost
# DB_PORT=3306
