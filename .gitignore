# ===== 项目根目录 .gitignore =====

# Python 虚拟环境 (所有位置)
.venv/
venv/
ENV/
env/
platform/.venv/

# Python 字节码缓存
__pycache__/
*.pyc
*.pyo

# Node
node_modules/

# 环境变量
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 日志和临时文件
*.log
*.log.*
*.tmp
*.temp

# IoT 平台日志目录
iot_control_platform/logs/

# Simulation 真实配置（包含 broker 地址，使用 config.yaml.example 作为模板）
simulation/config.yaml

# Simulation webui 运行时数据（sqlite、渲染的临时 manifest/config、日志）
simulation/webui/runtime/

# 私密课程作业与参考资料（仅保留在本机，不上传 GitHub）
docs/not_uploaded_to_github_documents/
